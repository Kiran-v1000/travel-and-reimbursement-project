// Travel & Reimbursement System - data model
// Migrations live in ./migrations (versioned, never edited after apply).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  EMPLOYEE
  MANAGER
  FINANCE
  ADMIN
  AUDITOR
}

enum EntityType {
  TRAVEL
  EXPENSE
}

enum TravelStatus {
  DRAFT
  PENDING
  RETURNED
  APPROVED
  REJECTED
  WITHDRAWN
}

enum ExpenseStatus {
  DRAFT
  PENDING
  RETURNED
  FINANCE_REVIEW
  SCHEDULED
  PAID
  REJECTED
  WITHDRAWN
}

enum StepStatus {
  WAITING
  PENDING
  APPROVED
  REJECTED
  RETURNED
  SKIPPED
  CANCELLED
}

enum TravelType {
  DOMESTIC
  INTERNATIONAL
}

enum DelegationScope {
  ALL
  TRAVEL
  EXPENSE
}

enum PaymentStatus {
  SCHEDULED
  PAID
  FAILED
}

model Department {
  id        String         @id @default(cuid())
  code      String         @unique
  name      String
  headId    String?
  head      User?          @relation("DepartmentHead", fields: [headId], references: [id])
  members   User[]         @relation("DepartmentMembers")
  rules     ApprovalRule[]
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
}

model CostCenter {
  id        String          @id @default(cuid())
  code      String          @unique
  name      String
  active    Boolean         @default(true)
  users     User[]
  travels   TravelRequest[]
  expenses  ExpenseReport[]
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
}

model User {
  id                 String             @id @default(cuid())
  employeeId         String             @unique
  name               String
  email              String             @unique
  passwordHash       String?
  /// Set for seeded / admin-reset passwords: the user must choose a new one after signing in.
  mustChangePassword Boolean            @default(false)
  passwordChangedAt  DateTime?
  /// Microsoft Entra ID object id, set on first SSO sign-in.
  azureOid           String?            @unique
  role               Role               @default(EMPLOYEE)
  title              String?
  location           String?
  active             Boolean            @default(true)
  departmentId       String?
  department         Department?        @relation("DepartmentMembers", fields: [departmentId], references: [id])
  costCenterId       String?
  costCenter         CostCenter?        @relation(fields: [costCenterId], references: [id])
  managerId          String?
  manager            User?              @relation("Reports", fields: [managerId], references: [id])
  /// Every manager above this user, top first (materialised path). GIN-indexed so
  /// "whole team under X" is one index lookup even for the CEO of 100k people.
  ancestors          String[]           @default([])
  reports            User[]             @relation("Reports")
  headOf             Department[]       @relation("DepartmentHead")
  lastLoginAt        DateTime?
  travelRequests     TravelRequest[]    @relation("Requester")
  expenseReports     ExpenseReport[]    @relation("Claimant")
  approvalSteps      ApprovalStep[]     @relation("StepApprover")
  actedSteps         ApprovalStep[]     @relation("StepActor")
  delegationsGiven   Delegation[]       @relation("Delegator")
  delegationsTaken   Delegation[]       @relation("Delegate")
  notifications      Notification[]
  payments           Payment[]
  accountingExports  AccountingExport[]
  holdsPlaced        LegalHold[]        @relation("HoldPlacedBy")
  holdsReleased      LegalHold[]        @relation("HoldReleasedBy")
  holdsOn            LegalHold[]        @relation("HoldSubject")
  retentionRuns      RetentionRun[]
  sessions           Session[]
  attachments        Attachment[]
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  @@index([managerId])
  @@index([departmentId])
  @@index([ancestors], type: Gin)
  @@index([name])
  // Trigram indexes: fast "contains" search over 100k people (needs the pg_trgm extension).
  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin, map: "User_name_trgm_idx")
  @@index([email(ops: raw("gin_trgm_ops"))], type: Gin, map: "User_email_trgm_idx")
  @@index([employeeId(ops: raw("gin_trgm_ops"))], type: Gin, map: "User_employeeId_trgm_idx")
}

model Delegation {
  id          String          @id @default(cuid())
  delegatorId String
  delegator   User            @relation("Delegator", fields: [delegatorId], references: [id])
  delegateId  String
  delegate    User            @relation("Delegate", fields: [delegateId], references: [id])
  scope       DelegationScope @default(ALL)
  startDate   DateTime
  endDate     DateTime
  reason      String?
  revoked     Boolean         @default(false)
  createdAt   DateTime        @default(now())

  @@index([delegatorId])
  @@index([delegateId])
}

/// levels: [{ label, approvers: [{ type: MANAGER|SKIP_MANAGER|DEPT_HEAD|ROLE|USER, role?, userId? }] }]
/// Approvers inside one level act in parallel; levels act sequentially.
model ApprovalRule {
  id                String      @id @default(cuid())
  name              String
  entityType        EntityType
  priority          Int         @default(100)
  minAmount         Decimal     @default(0) @db.Decimal(14, 2)
  maxAmount         Decimal?    @db.Decimal(14, 2)
  departmentId      String?
  department        Department? @relation(fields: [departmentId], references: [id])
  costCenterCode    String?
  travelType        TravelType?
  onPolicyException Boolean     @default(false)
  levels            Json
  active            Boolean     @default(true)
  version           Int         @default(1)
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt
}

model TravelRequest {
  id              String          @id @default(cuid())
  code            String          @unique
  requesterId     String
  requester       User            @relation("Requester", fields: [requesterId], references: [id])
  title           String
  purpose         String
  travelType      TravelType      @default(DOMESTIC)
  origin          String
  destination     String
  startDate       DateTime
  endDate         DateTime
  travelers       String[]
  estTransport    Decimal         @default(0) @db.Decimal(14, 2)
  estLodging      Decimal         @default(0) @db.Decimal(14, 2)
  estMeals        Decimal         @default(0) @db.Decimal(14, 2)
  estOther        Decimal         @default(0) @db.Decimal(14, 2)
  currency        String          @default("INR")
  estTotalBase    Decimal         @default(0) @db.Decimal(14, 2)
  costCenterId    String?
  costCenter      CostCenter?     @relation(fields: [costCenterId], references: [id])
  projectCode     String?
  notes           String?
  policyFlags     Json            @default("[]")
  exceptionReason String?
  status          TravelStatus    @default(DRAFT)
  round           Int             @default(0)
  ruleId          String?
  ruleName        String?
  ruleVersion     Int?
  version         Int             @default(1)
  submittedAt     DateTime?
  decidedAt       DateTime?
  steps           ApprovalStep[]
  attachments     Attachment[]
  expenseReports  ExpenseReport[]
  /// Set when the retention job removed the personal details and receipts of this record.
  purgedAt        DateTime?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@index([requesterId, status])
  @@index([status, startDate])
  @@index([updatedAt])
}

model ExpenseReport {
  id              String         @id @default(cuid())
  code            String         @unique
  employeeId      String
  employee        User           @relation("Claimant", fields: [employeeId], references: [id])
  travelRequestId String?
  travelRequest   TravelRequest? @relation(fields: [travelRequestId], references: [id])
  title           String
  purpose         String
  costCenterId    String?
  costCenter      CostCenter?    @relation(fields: [costCenterId], references: [id])
  projectCode     String?
  currency        String         @default("INR")
  totalBase       Decimal        @default(0) @db.Decimal(14, 2)
  policyFlags     Json           @default("[]")
  exceptionReason String?
  status          ExpenseStatus  @default(DRAFT)
  round           Int            @default(0)
  ruleId          String?
  ruleName        String?
  ruleVersion     Int?
  version         Int            @default(1)
  submittedAt     DateTime?
  approvedAt      DateTime?
  financeNote     String?
  lines           ExpenseLine[]
  steps           ApprovalStep[]
  payment         Payment?
  /// Set when the retention job removed the personal details and receipts of this record.
  purgedAt        DateTime?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([employeeId, status])
  @@index([status, approvedAt])
  @@index([updatedAt])
  @@index([travelRequestId])
}

model ExpenseLine {
  id            String          @id @default(cuid())
  reportId      String
  report        ExpenseReport   @relation(fields: [reportId], references: [id], onDelete: Cascade)
  date          DateTime
  categoryId    String
  category      ExpenseCategory @relation(fields: [categoryId], references: [id])
  merchant      String
  description   String?
  amount        Decimal         @db.Decimal(14, 2)
  tax           Decimal         @default(0) @db.Decimal(14, 2)
  currency      String          @default("INR")
  fxRate        Decimal         @default(1) @db.Decimal(18, 8)
  fxDate        DateTime        @default(now())
  baseAmount    Decimal         @db.Decimal(14, 2)
  paymentMethod String          @default("PERSONAL_CARD")
  flags         Json            @default("[]")
  attachments   Attachment[]
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@index([reportId])
  @@index([date])
}

model ExpenseCategory {
  id               String        @id @default(cuid())
  code             String        @unique
  name             String
  icon             String        @default("receipt")
  perItemLimit     Decimal?      @db.Decimal(14, 2)
  receiptThreshold Decimal       @default(500) @db.Decimal(14, 2)
  /// Ledger / GL account the expense is booked to in accounting (e.g. "Travel - Airfare").
  glAccount        String?
  active           Boolean       @default(true)
  lines            ExpenseLine[]
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
}

model Currency {
  code       String   @id
  name       String
  symbol     String
  rateToBase Decimal  @db.Decimal(18, 8)
  active     Boolean  @default(true)
  updatedAt  DateTime @updatedAt
}

model Setting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

model ApprovalStep {
  id              String         @id @default(cuid())
  entityType      EntityType
  travelRequestId String?
  travelRequest   TravelRequest? @relation(fields: [travelRequestId], references: [id], onDelete: Cascade)
  expenseReportId String?
  expenseReport   ExpenseReport? @relation(fields: [expenseReportId], references: [id], onDelete: Cascade)
  round           Int            @default(1)
  level           Int
  label           String
  approverId      String
  approver        User           @relation("StepApprover", fields: [approverId], references: [id])
  actedById       String?
  actedBy         User?          @relation("StepActor", fields: [actedById], references: [id])
  status          StepStatus     @default(WAITING)
  comment         String?
  resolution      String?
  escalated       Boolean        @default(false)
  ruleName        String?
  ruleVersion     Int?
  dueAt           DateTime?
  activatedAt     DateTime?
  actedAt         DateTime?
  createdAt       DateTime       @default(now())

  @@index([approverId, status])
  @@index([status, dueAt])
  @@index([actedById, actedAt])
  @@index([travelRequestId])
  @@index([expenseReportId])
}

model Payment {
  id            String            @id @default(cuid())
  reportId      String            @unique
  report        ExpenseReport     @relation(fields: [reportId], references: [id])
  method        String
  amount        Decimal           @db.Decimal(14, 2)
  currency      String            @default("INR")
  scheduledFor  DateTime?
  paidAt        DateTime?
  reference     String?
  status        PaymentStatus     @default(SCHEDULED)
  recordedById  String
  recordedBy    User              @relation(fields: [recordedById], references: [id])
  /// Set when the payment is included in an accounting export (prevents double booking).
  exportBatchId String?
  exportBatch   AccountingExport? @relation(fields: [exportBatchId], references: [id])
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  @@index([status, paidAt])
  @@index([exportBatchId])
}

/// One accounting export run (CSV journal or Tally XML) - can be re-downloaded exactly.
model AccountingExport {
  id          String    @id @default(cuid())
  format      String // CSV | TALLY
  fromDate    DateTime
  toDate      DateTime
  payments    Int       @default(0)
  lines       Int       @default(0)
  total       Decimal   @default(0) @db.Decimal(16, 2)
  createdById String
  createdBy   User      @relation(fields: [createdById], references: [id])
  createdAt   DateTime  @default(now())
  items       Payment[]

  @@index([createdAt])
}

model Attachment {
  id              String         @id @default(cuid())
  originalName    String
  storedName      String         @unique
  mimeType        String
  size            Int
  uploadedById    String
  uploadedBy      User           @relation(fields: [uploadedById], references: [id])
  travelRequestId String?
  travelRequest   TravelRequest? @relation(fields: [travelRequestId], references: [id], onDelete: Cascade)
  expenseLineId   String?
  expenseLine     ExpenseLine?   @relation(fields: [expenseLineId], references: [id], onDelete: Cascade)
  createdAt       DateTime       @default(now())

  // Foreign keys need indexes, or every parent delete scans this table.
  @@index([travelRequestId])
  @@index([expenseLineId])
}

/// Snapshot of a request / report each time it is (re)submitted.
model Revision {
  id          String     @id @default(cuid())
  entityType  EntityType
  entityId    String
  version     Int
  snapshot    Json
  createdById String
  createdAt   DateTime   @default(now())

  @@index([entityType, entityId])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String
  title     String
  body      String
  link      String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, read])
  @@index([userId, createdAt])
  @@index([read, createdAt])
}

/// Append-only, hash-chained audit trail (tamper evident).
model AuditLog {
  id         String   @id @default(cuid())
  seq        Int      @unique @default(autoincrement())
  actorId    String?
  actorName  String?
  action     String
  entityType String
  entityId   String?
  details    Json     @default("{}")
  prevHash   String
  hash       String
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
  @@index([createdAt])
}

/// Bulk HR import runs (CSV). Stored in the DB so any API worker can report progress.
model ImportJob {
  id          String    @id @default(cuid())
  kind        String    @default("USERS")
  mode        String // VALIDATE | APPLY
  status      String    @default("RUNNING") // RUNNING | DONE | FAILED
  fileName    String
  totalRows   Int       @default(0)
  processed   Int       @default(0)
  summary     Json      @default("{}")
  errors      Json      @default("[]")
  createdById String
  createdAt   DateTime  @default(now())
  finishedAt  DateTime?

  @@index([createdAt])
}

model Counter {
  key   String @id
  value Int    @default(0)
}

enum HoldScope {
  EMPLOYEE
  EXPENSE
  TRAVEL
  PERIOD
}

/// Legal hold: records it covers are never purged by retention and cannot be edited or deleted.
model LegalHold {
  id            String    @id @default(cuid())
  scope         HoldScope
  /// EMPLOYEE: everything this person submitted.
  userId        String?
  user          User?     @relation("HoldSubject", fields: [userId], references: [id])
  /// EXPENSE / TRAVEL: one record (and, for a trip, its expense reports).
  entityId      String?
  /// PERIOD: every record created in this range.
  fromDate      DateTime?
  toDate        DateTime?
  /// What the hold covers, for display ("EX-2026-0042", "Rahul Menon", "1 Apr 2022 - 31 Mar 2023").
  subject       String
  reason        String
  reference     String?
  placedById    String
  placedBy      User      @relation("HoldPlacedBy", fields: [placedById], references: [id])
  placedAt      DateTime  @default(now())
  releasedById  String?
  releasedBy    User?     @relation("HoldReleasedBy", fields: [releasedById], references: [id])
  releasedAt    DateTime?
  releaseReason String?

  @@index([releasedAt, scope])
  @@index([userId])
  @@index([entityId])
}

/// One run of the retention job (or a dry run / preview kept for the record).
model RetentionRun {
  id            String    @id @default(cuid())
  /// RUNNING | DONE | FAILED. At most one RUNNING row (partial unique index in the migration).
  status        String    @default("RUNNING")
  trigger       String // SCHEDULED | MANUAL
  cutoff        DateTime
  expenses      Int       @default(0)
  trips         Int       @default(0)
  files         Int       @default(0)
  bytes         Float     @default(0)
  skippedOnHold Int       @default(0)
  error         String?
  triggeredById String?
  triggeredBy   User?     @relation(fields: [triggeredById], references: [id])
  startedAt     DateTime  @default(now())
  finishedAt    DateTime?

  @@index([startedAt])
}

/// A finished analytics result for one scope + date range, shared by every API server and kept
/// across restarts. Served at once; refreshed in the background when older than the cache time.
/// Built nightly for the whole organisation and every large team.
model AnalyticsSnapshot {
  /// "<scope user id | org>|<from>|<to>"
  key        String   @id
  data       Json
  computedAt DateTime
  computeMs  Int

  @@index([computedAt])
}

/// One signed-in session (the JWT's jti). Lets the server end a session on sign-out, after
/// inactivity, on deactivation or password reset - instead of trusting the token until it expires.
model Session {
  id            String    @id @default(cuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// PASSWORD | SSO
  method        String
  createdAt     DateTime  @default(now())
  lastSeenAt    DateTime  @default(now())
  expiresAt     DateTime
  revokedAt     DateTime?
  /// SIGN_OUT | IDLE | DEACTIVATED | PASSWORD_CHANGED | PASSWORD_RESET | ADMIN
  revokedReason String?
  ip            String?
  userAgent     String?

  @@index([userId, revokedAt])
  @@index([expiresAt])
}

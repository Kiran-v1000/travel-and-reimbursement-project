{
  "name": "voyage-server",
  "version": "1.0.0",
  "description": "Travel & Reimbursement System - API (Node.js, Express, Prisma, PostgreSQL)",
  "type": "module",
  "main": "src/server.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "node src/db/seeds/seed.js",
    "db:reset": "prisma migrate reset --force",
    "test": "node --test \"src/**/*.test.js\"",
    "test:e2e": "node --test \"tests/**/*.test.js\"",
    "db:seed:scale": "node src/db/seeds/scale.js",
    "load:test": "node tests/load/load-test.js",
    "start:cluster": "pm2 start ecosystem.config.cjs --env production"
  },
  "prisma": {
    "schema": "src/db/schema.prisma",
    "seed": "node src/db/seeds/seed.js"
  },
  "dependencies": {
    "@azure/msal-node": "^7.2.3",
    "@prisma/client": "^5.22.0",
    "bcryptjs": "^2.4.3",
    "compression": "^1.7.5",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "csv-parse": "^7.0.3",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "express-rate-limit": "^7.4.1",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "node-cron": "^4.6.0",
    "nodemailer": "^10.6.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "autocannon": "^7.15.0",
    "prisma": "^5.22.0"
  }
}

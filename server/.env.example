NODE_ENV=development
PORT=4010
# postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public&connection_limit=N&pool_timeout=20
# connection_limit is PER API WORKER: workers x connection_limit must stay below Postgres
# max_connections (or put PgBouncer in transaction mode in front and add &pgbouncer=true).
DATABASE_URL=postgresql://postgres:change-me@localhost:5432/travel_reimbursement?schema=public&connection_limit=15&pool_timeout=20
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-secret
# Sessions are kept on the server and can be ended at any time (sign-out, deactivation, password change).
SESSION_HOURS=8
SESSION_IDLE_MINUTES=30
# Finance and Administrators: shorter limits.
PRIVILEGED_SESSION_HOURS=4
PRIVILEGED_IDLE_MINUTES=15
# true = Finance and Administrators must sign in with Microsoft (company MFA / Conditional Access).
# Needs SSO_ENABLED=true. BREAK_GLASS_EMAILS may still use a password (emergency admin accounts only).
PRIVILEGED_SSO_ONLY=false
BREAK_GLASS_EMAILS=
# Comma separated list of allowed browser origins
CLIENT_URL=http://localhost:5195
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=10
# Malware scanning of uploads with ClamAV (clamd). When set, every upload is scanned and refused if
# infected or if the scanner cannot be reached. Install: apt install clamav-daemon (listens on 3310).
CLAMAV_HOST=
CLAMAV_PORT=3310
# Microsoft Entra ID (Azure AD) single sign-on for company accounts.
# App registration: Web platform, redirect URI = AZURE_AD_REDIRECT_URI, a client secret,
# delegated permissions openid, profile, email, User.Read.
SSO_ENABLED=false
AZURE_AD_TENANT_ID=
AZURE_AD_CLIENT_ID=
AZURE_AD_CLIENT_SECRET=
# Must go through the same origin as the web app (nginx / Vite proxy) so the session cookie lands there.
AZURE_AD_REDIRECT_URI=http://localhost:5195/api/auth/sso/callback
# Only these email domains may sign in with SSO (comma separated)
SSO_ALLOWED_DOMAINS=utthunga.com
# Create an Employee account automatically on first SSO sign-in (admins assign manager/role later)
SSO_AUTO_PROVISION=true
# Update "reports to", job title, department and office from Microsoft at each SSO sign-in
SSO_SYNC_DIRECTORY=true
# Optional: local administrator created by the seed
SEED_ADMIN_EMAIL=admin@utthunga.com
SEED_ADMIN_PASSWORD=change-me
ESCALATION_CRON=*/15 * * * *

# Capacity / operations (defaults suit ~100k employees)
API_RATE_LIMIT_PER_MIN=300       # per signed-in session, per API worker
ANALYTICS_CACHE_SECONDS=300      # analytics are cached and refreshed in the background
REQUEST_LOGGING=false            # nginx access logs cover requests in production
SLOW_QUERY_MS=500                # log SQL slower than this (0 = off)

# Optional - leave blank to use in-app notifications only
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Voyage T&E <no-reply@company.local>

NODE_ENV=development
PORT=4010
# postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public
DATABASE_URL=postgresql://postgres:change-me@localhost:5432/travel_reimbursement?schema=public
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=8h
# Comma separated list of allowed browser origins
CLIENT_URL=http://localhost:5195
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=10
SSO_ENABLED=false
ESCALATION_CRON=*/15 * * * *

# Optional - leave blank to use in-app notifications only
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Voyage T&E <no-reply@company.local>
